<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 170 210" width="170" height="210" role="img" aria-label="Illustrated character waving" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <style>
    .wave{transform-origin:106px 106px;animation:wave 1.6s ease-in-out infinite}
    @keyframes wave{0%,100%{transform:rotate(-10deg)}50%{transform:rotate(14deg)}}
    .eye{transform-box:fill-box;transform-origin:center;animation:blink 4.5s infinite}
    @keyframes blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}
    .heart{opacity:0;animation:float 3.6s ease-in infinite}
    @keyframes float{0%{transform:translateY(8px);opacity:0}20%{opacity:.95}100%{transform:translateY(-20px);opacity:0}}
    .bob{animation:bob 3s ease-in-out infinite}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
  </style>

  <ellipse cx="80" cy="203" rx="42" ry="6" fill="#a78bfa" opacity=".25"/>

  <!-- legs -->
  <rect x="60" y="146" width="17" height="44" rx="7" fill="#7c8fd6" stroke="#4c1d95" stroke-width="2.5"/>
  <rect x="83" y="146" width="17" height="44" rx="7" fill="#7c8fd6" stroke="#4c1d95" stroke-width="2.5"/>
  <ellipse cx="66" cy="194" rx="14" ry="7" fill="#f5f3ff" stroke="#4c1d95" stroke-width="2.5"/>
  <ellipse cx="94" cy="194" rx="14" ry="7" fill="#f5f3ff" stroke="#4c1d95" stroke-width="2.5"/>
  <path d="M56 194 h20 M84 194 h20" stroke="#f0abfc" stroke-width="3" stroke-linecap="round"/>

  <g class="bob">
    <!-- resting arm -->
    <path d="M54 106 Q36 128 42 148" fill="none" stroke="#4c1d95" stroke-width="18" stroke-linecap="round"/>
    <path d="M54 106 Q36 128 42 148" fill="none" stroke="#a78bfa" stroke-width="13" stroke-linecap="round"/>
    <circle cx="42" cy="152" r="7.5" fill="#e8b48c" stroke="#4c1d95" stroke-width="2.5"/>

    <!-- hoodie -->
    <rect x="50" y="90" width="60" height="64" rx="20" fill="#a78bfa" stroke="#4c1d95" stroke-width="2.5"/>
    <path d="M66 138 h28 l-3 12 h-22 z" fill="#c4b5fd" stroke="#4c1d95" stroke-width="2" stroke-linejoin="round"/>
    <path d="M72 92 q8 12 16 0" fill="none" stroke="#4c1d95" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M76 100 v14 M84 100 v14" stroke="#f5f3ff" stroke-width="2" stroke-linecap="round"/>

    <!-- waving arm -->
    <g class="wave">
      <path d="M106 106 Q132 100 136 74" fill="none" stroke="#4c1d95" stroke-width="18" stroke-linecap="round"/>
      <path d="M106 106 Q132 100 136 74" fill="none" stroke="#a78bfa" stroke-width="13" stroke-linecap="round"/>
      <circle cx="136" cy="68" r="8" fill="#e8b48c" stroke="#4c1d95" stroke-width="2.5"/>
    </g>

    <!-- neck + head -->
    <rect x="73" y="80" width="14" height="14" rx="4" fill="#e8b48c" stroke="#4c1d95" stroke-width="2.5"/>
    <circle cx="80" cy="22" r="12" fill="#2d1b3d" stroke="#4c1d95" stroke-width="2.5"/>
    <circle cx="80" cy="58" r="29" fill="#e8b48c" stroke="#4c1d95" stroke-width="2.5"/>
    <path d="M51 58 Q48 22 80 24 Q112 22 109 58 Q102 38 80 40 Q58 38 51 58 Z" fill="#2d1b3d" stroke="#4c1d95" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="64" cy="69" r="5.5" fill="#f0abfc" opacity=".6"/>
    <circle cx="96" cy="69" r="5.5" fill="#f0abfc" opacity=".6"/>
    <ellipse class="eye" cx="70" cy="60" rx="3.2" ry="5" fill="#2d1b3d"/>
    <ellipse class="eye" cx="90" cy="60" rx="3.2" ry="5" fill="#2d1b3d"/>
    <circle cx="71.2" cy="58" r="1.2" fill="#fff"/>
    <circle cx="91.2" cy="58" r="1.2" fill="#fff"/>
    <path d="M72 72 Q80 80 88 72" fill="none" stroke="#4c1d95" stroke-width="2.5" stroke-linecap="round"/>
  </g>

  <!-- floating heart -->
  <g transform="translate(152 52)">
    <path class="heart" d="M0 0 c-6 -8 -16 0 -8 8 l8 8 l8 -8 c8 -8 -2 -16 -8 -8z" fill="#f0abfc"/>
  </g>
</svg>
