<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 300" width="900" height="300" role="img" aria-label="Swagatika Barik, software developer, AI enthusiast and community mentor" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="night" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1b1740"/><stop offset="1" stop-color="#312c70"/>
    </linearGradient>
    <radialGradient id="glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#a78bfa" stop-opacity=".45"/><stop offset="1" stop-color="#a78bfa" stop-opacity="0"/>
    </radialGradient>
    <clipPath id="card"><rect x="1" y="1" width="898" height="298" rx="14"/></clipPath>
  </defs>
  <style>
    .tw{animation:tw 3.4s ease-in-out infinite}
    @keyframes tw{0%,100%{opacity:.25}50%{opacity:1}}
    .bob{animation:bob 3.4s ease-in-out infinite}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
    .eye{transform-box:fill-box;transform-origin:center;animation:blink 4.5s infinite}
    @keyframes blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}
    .heart{opacity:0;animation:float 4s ease-in infinite}
    @keyframes float{0%{transform:translateY(10px);opacity:0}20%{opacity:.95}100%{transform:translateY(-26px);opacity:0}}
    .logo{animation:logo 3s ease-in-out infinite}
    @keyframes logo{0%,100%{opacity:.55}50%{opacity:1}}
  </style>

  <g clip-path="url(#card)">
    <rect width="900" height="300" fill="url(#night)"/>
    <circle cx="760" cy="150" r="190" fill="url(#glow)"/>

    <!-- stars -->
    <g fill="#f5f3ff">
      <circle class="tw" cx="40" cy="40" r="1.6"/>
      <circle class="tw" style="animation-delay:.6s" cx="130" cy="262" r="1.4"/>
      <circle class="tw" style="animation-delay:1.2s" cx="330" cy="34" r="1.8"/>
      <circle class="tw" style="animation-delay:1.8s" cx="520" cy="270" r="1.5"/>
      <circle class="tw" style="animation-delay:2.4s" cx="560" cy="120" r="1.3"/>
      <circle class="tw" style="animation-delay:.3s" cx="610" cy="250" r="1.6"/>
      <circle class="tw" style="animation-delay:1.5s" cx="860" cy="40" r="1.7"/>
      <circle class="tw" style="animation-delay:2.1s" cx="880" cy="190" r="1.3"/>
      <circle class="tw" style="animation-delay:.9s" cx="455" cy="60" r="1.2"/>
      <circle class="tw" style="animation-delay:2.7s" cx="240" cy="280" r="1.5"/>
    </g>
    <path class="tw" d="M600 28 A22 22 0 1 0 622 68 A17 17 0 1 1 600 28 Z" fill="#ede9fe" style="animation-duration:6s"/>
  </g>

  <!-- name + subtitle -->
  <text x="48" y="128" font-family="'Helvetica Neue',Arial,sans-serif" font-size="52" font-weight="800" fill="#f5f3ff" letter-spacing="1">SWAGATIKA BARIK</text>
  <rect x="48" y="150" width="520" height="40" rx="5" fill="#4c3fa8" opacity=".55"/>
  <rect x="48" y="196" width="262" height="40" rx="5" fill="#4c3fa8" opacity=".55"/>
