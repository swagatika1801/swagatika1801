      <circle cx="110" cy="80" r="36" fill="#e8b48c" stroke="#5b21b6" stroke-width="2.5"/>
      <path d="M74 82 Q72 40 110 42 Q148 40 146 82 Q138 58 110 58 Q82 58 74 82Z" fill="#2d1b3d" stroke="#5b21b6" stroke-width="2.5" stroke-linejoin="round"/>
      <circle cx="90" cy="95" r="6" fill="#f0abfc" opacity=".6"/>
      <circle cx="130" cy="95" r="6" fill="#f0abfc" opacity=".6"/>
      <ellipse class="eye" cx="98" cy="85" rx="3.6" ry="5.5" fill="#2d1b3d"/>
      <ellipse class="eye" cx="122" cy="85" rx="3.6" ry="5.5" fill="#2d1b3d"/>
      <circle cx="99.3" cy="83" r="1.3" fill="#fff"/><circle cx="123.3" cy="83" r="1.3" fill="#fff"/>
      <path d="M99 99 Q110 109 121 99" fill="none" stroke="#5b21b6" stroke-width="2.5" stroke-linecap="round"/>
      <!-- arms -->
      <path d="M62 160 Q40 208 70 240" fill="none" stroke="#5b21b6" stroke-width="22" stroke-linecap="round"/>
      <path d="M62 160 Q40 208 70 240" fill="none" stroke="#a78bfa" stroke-width="16" stroke-linecap="round"/>
      <path d="M158 160 Q180 208 150 240" fill="none" stroke="#5b21b6" stroke-width="22" stroke-linecap="round"/>
      <path d="M158 160 Q180 208 150 240" fill="none" stroke="#a78bfa" stroke-width="16" stroke-linecap="round"/>
      <!-- laptop (lid facing us) -->
      <rect x="62" y="186" width="96" height="62" rx="7" fill="#ddd6fe" stroke="#5b21b6" stroke-width="2.5"/>
      <path class="logo" d="M110 204 l4 9 l9 4 l-9 4 l-4 9 l-4 -9 l-9 -4 l9 -4z" fill="#f0abfc"/>
      <rect x="54" y="248" width="112" height="7" rx="3.5" fill="#c4b5fd" stroke="#5b21b6" stroke-width="2.5"/>
      <circle cx="68" cy="244" r="8.5" fill="#e8b48c" stroke="#5b21b6" stroke-width="2.5"/>
      <circle cx="152" cy="244" r="8.5" fill="#e8b48c" stroke="#5b21b6" stroke-width="2.5"/>
    </g>
    <g transform="translate(182 70)"><path class="heart" d="M0 0 c-6 -8 -16 0 -8 8 l8 8 l8 -8 c8 -8 -2 -16 -8 -8z" fill="#f0abfc"/></g>
  </g>

  <rect x="1" y="1" width="898" height="298" rx="14" fill="none" stroke="#4c3fa8" stroke-width="2"/>
