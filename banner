  </g>

  <!-- character with laptop -->
  <g transform="translate(646 22)">
    <g class="bob">
      <!-- hair back + bun -->
      <circle cx="110" cy="22" r="14" fill="#2d1b3d" stroke="#5b21b6" stroke-width="2.5"/>
